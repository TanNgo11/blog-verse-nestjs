# Enforce LF in the repository for text files
* text=auto eol=lf

# Explicitly set for common text file types
*.ts     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.graphql text eol=lf
